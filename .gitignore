# =========================================================
# Preset/background media
# =========================================================
# Large preset videos should not be committed directly.
# Store them externally or use Git LFS intentionally.

backend/storage/presets/*.mp4
backend/storage/presets/*.mov
backend/storage/presets/*.webm

# Keep lightweight docs/placeholders in preset folders.
!backend/storage/presets/.gitkeep
!backend/storage/presets/README.md

